<link rel="stylesheet" href="/css/border.css">

{{>layouts/header}}

<div class="cl-page-layout">
    {{>layouts/nav}}

    <main class="cl-main-content">
        <h2 class="board-title">게시글 수정</h2>

        {{#post}}
            <!-- 수정 폼: 기존 게시글 값을 보여주고 수정 완료 시 같은 번호의 글을 업데이트 -->
            <form action="/post/{{numbers}}/edit" method="post" enctype="multipart/form-data" class="post-form">

                <!-- 기존 itemType 값에 따라 분실물/습득물 radio 버튼이 체크됨. -->
                <div class="type-row">
                    <label>
                        <input type="radio" name="itemType" value="0" {{#lostItem}}checked{{/lostItem}} required>
                        분실물
                    </label>

                    <label>
                        <input type="radio" name="itemType" value="1" {{#foundItem}}checked{{/foundItem}}>
                        습득물
                    </label>
                </div>

                <div>
                    <label>제목</label>
                    <input type="text" name="title" value="{{title}}" required>
                </div>

                <div>
                    <label>내용</label>
                    <textarea name="content" required>{{content}}</textarea>
                </div>

                <div>
                    <label>물건 종류</label>
                    <input type="text" name="category" value="{{category}}" required>
                </div>

                <div>
                    <label>장소</label>
                    <input type="text" name="location" value="{{location}}" required>
                </div>

                {{#image}}
                    <div class="image-preview-row">
                        <label>현재 이미지</label>
                        <img src="{{image}}" alt="현재 이미지" class="edit-image-preview">
                    </div>
                {{/image}}

                <div>
                    <label>이미지 변경</label>
                    <input type="file" name="imageFile" accept="image/*">
                </div>

                <button type="submit">수정 완료</button>
                <a href="/mypages">취소</a>
            </form>
        {{/post}}

        {{^post}}
            <div style="text-align: center; padding: 40px;">
                <h2>접근 권한이 없습니다.</h2>
                <p>자신의 게시글만 수정할 수 있습니다.</p>
                <a href="/mypages" style="color: #007bff; text-decoration: none;">마이페이지로 돌아가기</a>
            </div>
        {{/post}}
    </main>
</div>

{{>layouts/footer}}
