<link rel="stylesheet" href="/css/board.css">

{{>layouts/header}}

<div class="cl-page-layout">

    {{>layouts/nav}}

    <main class="cl-main-content">

        <h2 class="board-title">
            습득물 게시판
        </h2>
        <div class="board-search-area">

            <form action="/found" method="get">

                <input type="text"
                       name="keyword"
                       placeholder="제목 검색"
                       value="{{keyword}}"
                       class="board-search-input">

                <button type="submit"
                        class="board-search-button">
                    검색
                </button>

            </form>

        </div>
        <table class="board-table">

            <thead>

            <tr>
                <th>번호</th>
                <th>작성자</th>
                <th>제목</th>
                <th>내용</th>
                <th>작성일</th>
            </tr>

            </thead>

            <tbody>

            {{#foundPosts}}

                <tr>

                    <td>{{viewNumber}}</td>

                    <td>{{userId}}</td>

                    <td>

                        <a href="/post/{{numbers}}"
                           class="board-detail-link">

                            {{title}}

                        </a>

                    </td>

                    <td class="board-content-cell">

                        {{content}}

                    </td>

                    <td>{{formattedCreatedAt}}</td>

                </tr>

            {{/foundPosts}}

            {{^foundPosts}}

                <tr>

                    <td colspan="5">
                        등록된 습득물이 없습니다.
                    </td>

                </tr>

            {{/foundPosts}}

            </tbody>

        </table>

    </main>

</div>

{{>layouts/footer}}
