<link rel="stylesheet" href="/css/border.css">

{{>layouts/header}}

<div class="cl-page-layout">
    {{>layouts/nav}}

    <main class="cl-main-content">
        <h2 class="board-title">분실물 / 습득물 등록</h2>

        <!-- 등록 폼: 분실물/습득물 정보를 입력해서 post 테이블에 저장 -->
        <form action="/post" method="post" enctype="multipart/form-data" class="post-form">


            <div class="type-row">
                <label>
                    <input type="radio" name="itemType" value="0" checked>
                    분실물
                </label>

                <label>
                    <input type="radio" name="itemType" value="1">
                    습득물
                </label>
            </div>

            <div>
                <label>제목</label>
                <input type="text" name="title" required>
            </div>

            <div>
                <label>내용</label>
                <textarea name="content" required></textarea>
            </div>

            <div>
                <label>물건 종류</label>
                <input type="text" name="category" placeholder="예: 학생증, 지갑, 이어폰" required>
            </div>

            <div>
                <label>장소</label>
                <input type="text" name="location" placeholder="예: 도서관, 강의실" required>
            </div>

            <!-- 이미지 파일은 MainController에서 static/images 폴더에 저장함 -->
            <div>
                <label>이미지</label>
                <input type="file" name="imageFile" accept="image/*">
            </div>

            <button type="submit">등록하기</button>
        </form>
    </main>
</div>

{{>layouts/footer}}
